@model DC_BOUTIQUE.Core.Application.ViewModels.Caja.TurnoCajaViewModel?
@{
    ViewData["Title"] = Model != null ? "Turno de Caja Activo" : "Caja Registradora";
    var gastos = ViewBag.Gastos as List<DC_BOUTIQUE.Core.Application.ViewModels.Caja.GastoCajaViewModel> ?? new();
}

@if (Model == null)
{
    <div class="row justify-content-center my-5">
        <div class="col-12 col-md-7 col-lg-5 text-center">
            <div class="dc-card py-5 px-4 shadow-sm">
                <div class="mb-3">
                    <div class="p-3 bg-light rounded-circle text-primary d-inline-block fs-1 shadow-sm" style="color: var(--dc-sky) !important;">
                        <i class="bi bi-safe2"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-2">Caja Actualmente Cerrada</h3>
                <p class="text-muted small mb-4">No hay un turno de caja activo en este momento. Para comenzar a facturar en el punto de venta (POS), debes aperturar la caja indicando el fondo inicial en efectivo.</p>
                
                <a asp-action="Abrir" class="btn btn-dc-sky w-100 py-3 fs-5 shadow-sm">
                    <i class="bi bi-unlock-fill me-1"></i> Abrir Turno de Caja
                </a>
                <a asp-action="Historial" class="btn btn-outline-secondary w-100 py-2 mt-2">
                    <i class="bi bi-clock-history me-1"></i> Ver Historial de Cajas y Cierres
                </a>
            </div>
        </div>
    </div>
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success px-2 py-1"><i class="bi bi-circle-fill me-1" style="font-size:8px;"></i> ACTIVO</span>
                <h1 class="h3 fw-bold mb-0 text-dark">Turno de Caja: @Model.CodigoTurno</h1>
            </div>
            <p class="text-muted mb-0 small">Aperturado el @Model.FechaApertura.ToString("dd/MM/yyyy hh:mm tt") por <strong>@Model.NombreUsuario</strong>.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Historial" class="btn btn-outline-sky shadow-sm">
                <i class="bi bi-clock-history me-1"></i> Historial de Cajas
            </a>
            <a asp-controller="Pos" asp-action="Index" class="btn btn-dc-sky shadow-sm">
                <i class="bi bi-cart4 me-1"></i> Ir a Facturar al POS [F1]
            </a>
            <a asp-action="Cerrar" class="btn btn-outline-danger shadow-sm">
                <i class="bi bi-lock-fill me-1"></i> Realizar Cuadre / Cerrar Caja
            </a>
        </div>
    </div>

    <!-- TARJETAS DE ARQUEO EN VIVO -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-3">
            <div class="dc-card p-3 mb-0 h-100 border-start border-4 border-secondary">
                <span class="text-muted small text-uppercase fw-bold">Fondo Inicial</span>
                <h4 class="fw-bold my-1 text-dark">RD$ @Model.FondoInicialEfectivo.ToString("N2")</h4>
                <span class="small text-muted">Apertura de turno</span>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="dc-card p-3 mb-0 h-100 border-start border-4 border-success">
                <span class="text-muted small text-uppercase fw-bold">Ventas en Efectivo</span>
                <h4 class="fw-bold my-1 text-success">+ RD$ @Model.TotalVentasEfectivo.ToString("N2")</h4>
                <span class="small text-muted">Ingresos al cajón</span>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="dc-card p-3 mb-0 h-100 border-start border-4 border-danger">
                <span class="text-muted small text-uppercase fw-bold">Gastos en Efectivo</span>
                <h4 class="fw-bold my-1 text-danger">- RD$ @Model.TotalGastosEfectivo.ToString("N2")</h4>
                <span class="small text-muted">Egresos registrados</span>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="dc-card p-3 mb-0 h-100 border-start border-4 border-primary bg-light">
                <span class="text-muted small text-uppercase fw-bold">Efectivo en Caja</span>
                <h4 class="fw-bold my-1 text-primary">RD$ @Model.EfectivoEsperadoEnCaja.ToString("N2")</h4>
                <span class="small text-success fw-bold"><i class="bi bi-check-circle"></i> Debe haber en cajón</span>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- GASTOS DE CAJA REGISTRADOS -->
        <div class="col-12 col-lg-7">
            <div class="dc-card h-100">
                <div class="dc-card-header">
                    <h5 class="dc-card-title">Gastos Menores del Turno</h5>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalNuevoGasto">
                        <i class="bi bi-dash-circle me-1"></i> Registrar Salida / Gasto
                    </button>
                </div>

                @if (gastos.Any())
                {
                    <div class="table-responsive">
                        <table class="table-dc">
                            <thead>
                                <tr>
                                    <th>Concepto</th>
                                    <th>Categoría</th>
                                    <th>Método</th>
                                    <th class="text-end">Monto</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var g in gastos)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-dark">@g.Concepto</div>
                                            <div class="text-muted" style="font-size:11px;">@g.FechaCreacion.ToString("hh:mm tt") · Por: @g.NombreUsuario</div>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@g.CategoriaGasto</span></td>
                                        <td>@g.MetodoPago</td>
                                        <td class="text-end fw-bold text-danger">- RD$ @g.Monto.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-clipboard-check display-5 d-block mb-2 text-secondary opacity-50"></i>
                        No se han registrado salidas ni gastos en este turno.
                    </div>
                }
            </div>
        </div>

        <!-- OTROS MÉTODOS DE PAGO EN EL TURNO -->
        <div class="col-12 col-lg-5">
            <div class="dc-card h-100">
                <h5 class="dc-card-title mb-3">Ventas No Efectivo (Electrónicas)</h5>
                <div class="list-group list-group-flush mb-3">
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                        <div>
                            <div class="fw-bold text-dark"><i class="bi bi-credit-card text-primary me-2"></i>Tarjetas de Crédito / Débito</div>
                            <small class="text-muted">Vouchers de verifone (CardNET / Azul)</small>
                        </div>
                        <span class="fw-bold fs-5 text-primary">RD$ @Model.TotalVentasTarjeta.ToString("N2")</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                        <div>
                            <div class="fw-bold text-dark"><i class="bi bi-phone text-success me-2"></i>Transferencias Bancarias</div>
                            <small class="text-muted">Popular, BHD, Banreservas, Qik</small>
                        </div>
                        <span class="fw-bold fs-5 text-success">RD$ @Model.TotalVentasTransferencia.ToString("N2")</span>
                    </div>
                </div>

                <div class="alert alert-info py-2 small mb-0 border-0" style="background-color: var(--dc-sky-bg); color: var(--dc-sky-hover);">
                    <i class="bi bi-info-circle me-1"></i> Estos montos electrónicos no van al cajón de efectivo; se concilian directamente en la cuenta bancaria.
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL PARA REGISTRAR GASTO RÁPIDO DE CAJA -->
    <div class="modal fade" id="modalNuevoGasto" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content dc-card p-0 border-0 shadow-lg">
                <div class="modal-header border-bottom bg-light px-4 py-3">
                    <h5 class="modal-title fw-bold text-dark mb-0">
                        <i class="bi bi-dash-circle text-danger me-2"></i> Registrar Salida / Gasto de Caja
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="RegistrarGasto" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="TurnoCajaId" value="@Model.Id" />
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-uppercase text-muted">Concepto del Gasto *</label>
                            <input name="Concepto" class="form-control" placeholder="Ej. Fundas de boutique, Almuerzo, Envío..." required />
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-bold small text-uppercase text-muted">Monto (RD$) *</label>
                                <input name="Monto" type="number" step="0.01" class="form-control fw-bold text-danger" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold small text-uppercase text-muted">Categoría</label>
                                <select name="CategoriaGasto" class="form-select">
                                    <option value="Insumos Boutique">Insumos Boutique</option>
                                    <option value="Envíos / Delivery">Envíos / Delivery</option>
                                    <option value="Limpieza & Mantenimiento">Limpieza & Mantenimiento</option>
                                    <option value="Alimentación / Refrigerio">Alimentación / Refrigerio</option>
                                    <option value="Otros Gastos">Otros Gastos</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-uppercase text-muted">Observaciones</label>
                            <input name="Observaciones" class="form-control" placeholder="Comprobante # o justificación" />
                        </div>
                    </div>
                    <div class="modal-footer border-top bg-light px-4 py-3">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger px-4">Confirmar Salida de Dinero</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

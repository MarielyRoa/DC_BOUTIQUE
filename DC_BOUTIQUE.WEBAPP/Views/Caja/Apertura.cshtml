@model DC_BOUTIQUE.Core.Application.ViewModels.Caja.AbrirTurnoViewModel
@{
    ViewData["Title"] = "Apertura de Caja";
    var ultimo = ViewBag.UltimoTurno as DC_BOUTIQUE.Core.Application.ViewModels.Caja.TurnoCajaViewModel;
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="dc-card text-center py-4">
            <div class="mb-3">
                <div class="p-3 bg-light rounded-circle text-primary d-inline-block fs-1 shadow-sm" style="color: var(--dc-sky) !important;">
                    <i class="bi bi-safe2"></i>
                </div>
            </div>

            <h3 class="fw-bold" style="font-family:'Cormorant Garamond', serif;font-size:28px;">Apertura de Caja Registradora</h3>
            <p class="text-muted small px-3">No hay un turno activo en este mostrador. Ingresa el fondo en efectivo para iniciar a facturar en el POS.</p>

            <form asp-action="Abrir" method="post" class="px-4 text-start">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="FondoInicialEfectivo" class="form-label fw-bold small text-uppercase">Fondo Inicial en Efectivo (RD$) *</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white fw-bold">RD$</span>
                        <input asp-for="FondoInicialEfectivo" type="number" step="0.01" class="form-control fw-bold fs-4 text-success" autofocus />
                    </div>
                    <span asp-validation-for="FondoInicialEfectivo" class="text-danger small"></span>
                    <small class="text-muted" style="font-size:11px;">Monto para cambio/devuelta de inicio de turno.</small>
                </div>

                <div class="mb-4">
                    <label asp-for="Observaciones" class="form-label fw-bold small text-uppercase">Observaciones de Apertura</label>
                    <input asp-for="Observaciones" class="form-control" placeholder="Ej. Billetes de 100, 200 y monedas..." />
                </div>

                <button type="submit" class="btn btn-dc-sky w-100 py-3 fs-5 shadow">
                    <i class="bi bi-unlock-fill me-1"></i> Abrir Caja & Activar POS
                </button>
            </form>

            @if (ultimo != null)
            {
                <div class="mt-4 pt-3 border-top text-muted small px-4">
                    <div class="fw-bold mb-1">Último turno cerrado:</div>
                    <div>Turno: <strong>@ultimo.CodigoTurno</strong> · Estado: <span class="badge bg-secondary">@ultimo.Estado</span></div>
                    <div>Fecha: @ultimo.FechaCierre?.ToString("dd/MM/yyyy hh:mm tt")</div>
                    <a asp-action="ImprimirCierre" asp-route-id="@ultimo.Id" target="_blank" onclick="window.open(this.href, 'TicketCierre', 'width=460,height=700,scrollbars=yes'); return false;" class="btn btn-sm btn-link text-decoration-none mt-1">
                        <i class="bi bi-printer me-1"></i> Reimprimir Comprobante de Cierre
                    </a>
                </div>
            }

            <div class="mt-3 px-4">
                <a asp-action="Historial" class="btn btn-sm btn-outline-secondary w-100 py-2">
                    <i class="bi bi-clock-history me-1"></i> Ver Historial Completo de Cajas & Arqueos
                </a>
            </div>
        </div>
    </div>
</div>

@model DC_BOUTIQUE.Core.Application.ViewModels.Categorias.SaveCategoriaViewModel
@{
    ViewData["Title"] = "Editar Categoría";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="dc-card">
            <div class="dc-card-header">
                <h4 class="dc-card-title">Editar Categoría</h4>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Volver al Catálogo
                </a>
            </div>

            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-bold small text-uppercase">Nombre de la Categoría *</label>
                    <input asp-for="Nombre" class="form-control" autofocus />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Descripcion" class="form-label fw-bold small text-uppercase">Descripción</label>
                    <textarea asp-for="Descripcion" rows="3" class="form-control"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-dark">Cancelar</a>
                    <button type="submit" class="btn btn-dc-gold px-4">
                        <i class="bi bi-arrow-repeat me-1"></i> Actualizar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

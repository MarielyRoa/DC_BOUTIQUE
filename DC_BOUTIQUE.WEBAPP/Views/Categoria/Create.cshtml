@model DC_BOUTIQUE.Core.Application.ViewModels.Categorias.SaveCategoriaViewModel
@{
    ViewData["Title"] = "Nueva Categoría";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="dc-card">
            <div class="dc-card-header">
                <h4 class="dc-card-title">Registrar Nueva Categoría</h4>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Volver al Catálogo
                </a>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-bold small text-uppercase">Nombre de la Categoría *</label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej. Vestidos de Noche, Calzado, Joyería..." autofocus />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Descripcion" class="form-label fw-bold small text-uppercase">Descripción (Opcional)</label>
                    <textarea asp-for="Descripcion" rows="3" class="form-control" placeholder="Detalles de las prendas o accesorios que abarca esta sección..."></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-dark">Cancelar</a>
                    <button type="submit" class="btn btn-dc-gold px-4">
                        <i class="bi bi-check2-circle me-1"></i> Guardar Categoría
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

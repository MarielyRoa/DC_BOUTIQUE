@model DC_BOUTIQUE.Core.Application.ViewModels.Clientes.SaveClienteViewModel
@{
    ViewData["Title"] = "Editar Clienta";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">
        <div class="dc-card">
            <div class="dc-card-header">
                <h4 class="dc-card-title">Editar Datos de la Clienta</h4>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Volver al Directorio
                </a>
            </div>

            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Nombres" class="form-label fw-bold small text-uppercase">Nombres *</label>
                        <input asp-for="Nombres" class="form-control" autofocus />
                        <span asp-validation-for="Nombres" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Apellidos" class="form-label fw-bold small text-uppercase">Apellidos *</label>
                        <input asp-for="Apellidos" class="form-control" />
                        <span asp-validation-for="Apellidos" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Telefono" class="form-label fw-bold small text-uppercase">Teléfono / WhatsApp *</label>
                        <input asp-for="Telefono" class="form-control" />
                        <span asp-validation-for="Telefono" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="CedulaORnc" class="form-label fw-bold small text-uppercase">Cédula o RNC</label>
                        <input asp-for="CedulaORnc" class="form-control" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Correo" class="form-label fw-bold small text-uppercase">Correo Electrónico</label>
                        <input asp-for="Correo" type="email" class="form-control" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Direccion" class="form-label fw-bold small text-uppercase">Dirección</label>
                        <input asp-for="Direccion" class="form-control" />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Notas" class="form-label fw-bold small text-uppercase">Notas</label>
                    <textarea asp-for="Notas" rows="2" class="form-control"></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-dark">Cancelar</a>
                    <button type="submit" class="btn btn-dc-gold px-4">
                        <i class="bi bi-arrow-repeat me-1"></i> Actualizar Clienta
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

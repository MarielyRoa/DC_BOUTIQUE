@model List<DC_BOUTIQUE.Core.Application.ViewModels.Clientes.ClienteViewModel>
@{
    ViewData["Title"] = "Cartera de Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1" style="font-family:'Cormorant Garamond', serif;font-size:28px;">Cartera de Clientes</h1>
        <p class="text-muted mb-0 small">Directorio de clientas, historial de compras, teléfonos y datos fiscales.</p>
    </div>
    <a asp-action="Create" class="btn btn-dc-gold shadow-sm">
        <i class="bi bi-person-plus me-1"></i> Nueva Clienta
    </a>
</div>

<!-- Buscador Rápido -->
<div class="dc-card p-3 mb-3">
    <form method="get" asp-action="Index" class="d-flex gap-2">
        <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
            <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control" placeholder="Buscar por nombre, teléfono o RNC/Cédula..." />
        </div>
        <button type="submit" class="btn btn-outline-dark">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(ViewBag.SearchTerm as string))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </form>
</div>

<div class="dc-card">
    <div class="table-responsive">
        <table class="table-dc">
            <thead>
                <tr>
                    <th>Nombre Completo</th>
                    <th>Teléfono</th>
                    <th>RNC / Cédula</th>
                    <th>Correo</th>
                    <th class="text-center">Compras</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@item.NombreCompleto</div>
                                @if (!string.IsNullOrWhiteSpace(item.Notas))
                                {
                                    <small class="text-muted">@item.Notas</small>
                                }
                            </td>
                            <td>
                                <i class="bi bi-telephone text-muted me-1"></i>@item.Telefono
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.CedulaORnc))
                                {
                                    <span class="badge bg-light text-dark border">@item.CedulaORnc</span>
                                }
                                else
                                {
                                    <span class="text-muted small">No registrado</span>
                                }
                            </td>
                            <td>
                                @(string.IsNullOrWhiteSpace(item.Correo) ? "-" : item.Correo)
                            </td>
                            <td class="text-center">
                                <span class="badge bg-primary-subtle text-primary">@item.TotalCompras compras</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark me-1" title="Editar">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-sm btn-outline-danger btn-confirm-delete" data-name="@item.NombreCompleto" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-people display-4 d-block mb-2 text-secondary"></i>
                            No se encontraron clientes registrados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-confirm-delete').forEach(btn => {
            btn.addEventListener('click', function() {
                const name = this.getAttribute('data-name');
                const form = this.closest('form');
                Swal.fire({
                    title: '¿Eliminar clienta?',
                    text: `Se retirará a "${name}" del directorio.`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#1A1816',
                    cancelButtonColor: '#716C66',
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then((r) => {
                    if (r.isConfirmed) form.submit();
                });
            });
        });
    </script>
}

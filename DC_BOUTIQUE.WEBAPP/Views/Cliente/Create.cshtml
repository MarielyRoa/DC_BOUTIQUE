@model DC_BOUTIQUE.Core.Application.ViewModels.Clientes.SaveClienteViewModel
@{
    ViewData["Title"] = "Registrar Clienta";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">
        <div class="dc-card">
            <div class="dc-card-header">
                <h4 class="dc-card-title">Registrar Nueva Clienta</h4>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Volver al Directorio
                </a>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Nombres" class="form-label fw-bold small text-uppercase">Nombres *</label>
                        <input asp-for="Nombres" class="form-control" autofocus />
                        <span asp-validation-for="Nombres" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Apellidos" class="form-label fw-bold small text-uppercase">Apellidos *</label>
                        <input asp-for="Apellidos" class="form-control" />
                        <span asp-validation-for="Apellidos" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Telefono" class="form-label fw-bold small text-uppercase">Teléfono / WhatsApp *</label>
                        <input asp-for="Telefono" class="form-control" placeholder="Ej. 809-555-1234" />
                        <span asp-validation-for="Telefono" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="CedulaORnc" class="form-label fw-bold small text-uppercase">Cédula o RNC (Para Factura con Crédito Fiscal)</label>
                        <input asp-for="CedulaORnc" class="form-control" placeholder="Ej. 402-XXXXXXX-X o 131XXXXXX" />
                        <span asp-validation-for="CedulaORnc" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Correo" class="form-label fw-bold small text-uppercase">Correo Electrónico</label>
                        <input asp-for="Correo" type="email" class="form-control" placeholder="clienta@correo.com" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Direccion" class="form-label fw-bold small text-uppercase">Dirección (Para Envíos)</label>
                        <input asp-for="Direccion" class="form-control" placeholder="Sector, Ciudad, Referencia..." />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Notas" class="form-label fw-bold small text-uppercase">Preferencias de Moda / Notas</label>
                    <textarea asp-for="Notas" rows="2" class="form-control" placeholder="Tallas preferidas (S, M, 38), colores favoritos, estilo..."></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-dark">Cancelar</a>
                    <button type="submit" class="btn btn-dc-gold px-4">
                        <i class="bi bi-check2-circle me-1"></i> Guardar Clienta
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

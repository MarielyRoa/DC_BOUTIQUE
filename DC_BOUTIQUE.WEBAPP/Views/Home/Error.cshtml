@model DC_BOUTIQUE.Core.Application.ViewModels.Common.ErrorViewModel
@{
    ViewData["Title"] = "Aviso del Sistema";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-6 text-center">
        <div class="dc-card p-5">
            <div class="p-3 bg-light rounded-circle d-inline-block text-warning mb-3">
                <i class="bi bi-exclamation-triangle-fill display-4"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">Aviso del Sistema</h3>
            <p class="text-muted mb-4">
                Ha ocurrido una situación inesperada al procesar la última acción.
                La base de datos y la sesión se mantienen seguras.
            </p>

            @if (Model?.ShowRequestId == true)
            {
                <div class="small text-muted mb-4">
                    Código de rastreo: <code>@Model.RequestId</code>
                </div>
            }

            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Admin" asp-action="Index" class="btn btn-dc-sky">
                    <i class="bi bi-speedometer2 me-1"></i> Ir al Dashboard
                </a>
                <a asp-controller="Pos" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-cart4 me-1"></i> Ir al POS
                </a>
            </div>
        </div>
    </div>
</div>

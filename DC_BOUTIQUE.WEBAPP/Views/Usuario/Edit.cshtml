@model DC_BOUTIQUE.Core.Application.ViewModels.Usuarios.SaveUsuarioViewModel
@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-7">
        <div class="dc-card">
            <div class="dc-card-header">
                <h4 class="dc-card-title">Editar Usuario: @Model.NombreUsuario</h4>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Volver a la Lista
                </a>
            </div>

            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="NombreCompleto" class="form-label fw-bold small text-uppercase">Nombre Completo *</label>
                    <input asp-for="NombreCompleto" class="form-control" autofocus />
                    <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="NombreUsuario" class="form-label fw-bold small text-uppercase">Nombre de Usuario *</label>
                        <input asp-for="NombreUsuario" class="form-control font-monospace" />
                        <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Password" class="form-label fw-bold small text-uppercase">Nueva Contraseña (Dejar en blanco si no cambia)</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Rol" class="form-label fw-bold small text-uppercase">Rol de Acceso *</label>
                        <select asp-for="Rol" class="form-select">
                            <option value="Vendedor">Vendedor / Cajero</option>
                            <option value="Administrador">Administrador</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="PorcentajeComision" class="form-label fw-bold small text-uppercase">% Comisión</label>
                        <div class="input-group">
                            <input asp-for="PorcentajeComision" type="number" step="0.1" class="form-control" />
                            <span class="input-group-text bg-white">%</span>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-6">
                        <label asp-for="Cedula" class="form-label fw-bold small text-uppercase">Cédula</label>
                        <input asp-for="Cedula" class="form-control" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Telefono" class="form-label fw-bold small text-uppercase">Teléfono</label>
                        <input asp-for="Telefono" class="form-control" />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-dark">Cancelar</a>
                    <button type="submit" class="btn btn-dc-gold px-4 py-2">
                        <i class="bi bi-arrow-repeat me-1"></i> Actualizar Usuario
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model DC_BOUTIQUE.Core.Application.ViewModels.Usuarios.SaveUsuarioViewModel
@{
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-7">
        <div class="dc-card">
            <div class="dc-card-header">
                <h4 class="dc-card-title">Registrar Nuevo Empleado / Usuario</h4>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Volver a la Lista
                </a>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="NombreCompleto" class="form-label fw-bold small text-uppercase">Nombre Completo *</label>
                    <input asp-for="NombreCompleto" class="form-control" autofocus />
                    <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="NombreUsuario" class="form-label fw-bold small text-uppercase">Nombre de Usuario (Login) *</label>
                        <input asp-for="NombreUsuario" class="form-control font-monospace" placeholder="Ej. dcorporan o maria01" />
                        <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Password" class="form-label fw-bold small text-uppercase">Contraseña / PIN *</label>
                        <input asp-for="Password" type="password" class="form-control" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Rol" class="form-label fw-bold small text-uppercase">Rol de Acceso *</label>
                        <select asp-for="Rol" class="form-select">
                            <option value="Vendedor">Vendedor / Cajero (Solo POS y Arqueo)</option>
                            <option value="Administrador">Administrador (Control Total)</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="PorcentajeComision" class="form-label fw-bold small text-uppercase">% Comisión por Venta</label>
                        <div class="input-group">
                            <input asp-for="PorcentajeComision" type="number" step="0.1" class="form-control" />
                            <span class="input-group-text bg-white">%</span>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-6">
                        <label asp-for="Cedula" class="form-label fw-bold small text-uppercase">Cédula</label>
                        <input asp-for="Cedula" class="form-control" placeholder="402-XXXXXXX-X" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Telefono" class="form-label fw-bold small text-uppercase">Teléfono</label>
                        <input asp-for="Telefono" class="form-control" placeholder="809-555-0000" />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-dark">Cancelar</a>
                    <button type="submit" class="btn btn-dc-gold px-4 py-2">
                        <i class="bi bi-check2-circle me-1"></i> Guardar Usuario
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

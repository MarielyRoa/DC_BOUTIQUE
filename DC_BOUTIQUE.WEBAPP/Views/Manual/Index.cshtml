<div class="row g-4">
    <!-- ATAJOS -->
    <div class="col-lg-4 manual-section" data-category="pos" data-keywords="atajos teclado teclas rapidas f1 f2 escape enter imprimir">
        <div class="dc-card h-100 mb-0">
            <h5 class="dc-card-title mb-3"><i class="bi bi-keyboard text-primary me-2"></i>Atajos de Teclado</h5>
            <table class="table-dc">
                <tbody>
                    <tr>
                        <td><span class="kbd-key">F1</span></td>
                        <td>Abrir directamente el módulo <strong>Cobro / POS</strong> desde cualquier pantalla.</td>
                    </tr>
                    <tr>
                        <td><span class="kbd-key">F2</span></td>
                        <td>Enfocar el buscador / escáner de código de barras en el POS.</td>
                    </tr>
                    <tr>
                        <td><span class="kbd-key">Enter</span></td>
                        <td>Agregar prenda escaneada o confirmar búsqueda rápida.</td>
                    </tr>
                    <tr>
                        <td><span class="kbd-key">Ctrl + P</span></td>
                        <td>Imprimir comprobante, ticket o esta guía de uso.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- FAQ INTERACTIVO -->
    <div class="col-lg-8 manual-section" data-category="faq" data-keywords="preguntas frecuentes ayuda errores luz apagon internet contraseña caja abierta otra computadora migrar">
        <div class="dc-card h-100 mb-0">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="dc-card-title mb-0"><i class="bi bi-patch-question-fill text-primary me-2"></i>Preguntas Frecuentes (Haz clic para desplegar)</h5>
                <button type="button" class="btn btn-sm btn-outline-secondary no-print" onclick="toggleAllFaq()">Expandir / Contraer</button>
            </div>

            <div class="faq-item open" data-faq-keywords="pos abrir caja turno bloqueo facturar">
                <button type="button" class="faq-question" onclick="toggleFaq(this)">
                    <span>¿Por qué al entrar al POS el sistema me manda a Abrir Caja?</span>
                    <i class="bi bi-chevron-down faq-chevron"></i>
                </button>
                <div class="faq-answer">
                    Por seguridad contable, ninguna venta puede registrarse sin un turno de caja activo. Solo debes ingresar el fondo inicial (puede ser <code>0.00</code> si inicias sin cambio) y pulsar <strong>Abrir Turno</strong>; de inmediato quedarás en el Punto de Venta.
                </div>
            </div>

            <div class="faq-item" data-faq-keywords="luz apagon electricidad corte datos perdidos sqlite wal">
                <button type="button" class="faq-question" onclick="toggleFaq(this)">
                    <span>¿Qué pasa si se va la luz o se apaga la computadora de golpe?</span>
                    <i class="bi bi-chevron-down faq-chevron"></i>
                </button>
                <div class="faq-answer">
                    El sistema guarda cada venta y movimiento de inventario de inmediato en modo seguro <strong>SQLite WAL</strong> (Write-Ahead Logging). Al encender la computadora nuevamente y abrir DC_BOUTIQUE, tu turno abierto, ventas y existencias seguirán intactos.
                </div>
            </div>

            <div class="faq-item" data-faq-keywords="internet wifi offline desconectado funciona">
                <button type="button" class="faq-question" onclick="toggleFaq(this)">
                    <span>¿Funciona el sistema si se cae el internet en la boutique?</span>
                    <i class="bi bi-chevron-down faq-chevron"></i>
                </button>
                <div class="faq-answer">
                    <strong>Sí, 100%.</strong> Toda la información y la base de datos viven dentro de tu propia computadora. Puedes facturar, abrir/cerrar caja, registrar prendas y generar respaldos sin conexión a internet.
                </div>
            </div>

            <div class="faq-item" data-faq-keywords="contraseña clave pin cambiar usuario cajero olvidada">
                <button type="button" class="faq-question" onclick="toggleFaq(this)">
                    <span>¿Cómo cambio la contraseña o desactivo a una cajera?</span>
                    <i class="bi bi-chevron-down faq-chevron"></i>
                </button>
                <div class="faq-answer">
                    Ingresa como Administrador y ve a <strong>Usuarios & Permisos</strong>. Pulsa el ícono de lápiz para editar el nombre, rol o nueva contraseña/PIN, o el botón de pausa/activación para deshabilitar o rehabilitar su acceso al instante.
                </div>
            </div>

            <div class="faq-item" data-faq-keywords="otra computadora cambiar pc migrar pasar datos respaldo">
                <button type="button" class="faq-question" onclick="toggleFaq(this)">
                    <span>¿Cómo paso todos mis datos a una computadora nueva?</span>
                    <i class="bi bi-chevron-down faq-chevron"></i>
                </button>
                <div class="faq-answer">
                    1) Instala DC_BOUTIQUE en la computadora nueva con el instalador.<br />
                    2) Copia el archivo <code>DC_BOUTIQUE.db</code> (y la carpeta <code>Images</code> si tienes fotos) desde <code>C:\ProgramData\DC_BOUTIQUE\</code> de la PC vieja hacia la misma ruta en la PC nueva.<br />
                    3) Abre el programa y tendrás todo tu inventario, clientes y ventas exactamente igual.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const STORAGE_KEY = 'dc_boutique_manual_checklist_v1';
        let activeCategory = 'all';

        // 1. Acordeón FAQ
        function toggleFaq(btn) {
            btn.closest('.faq-item').classList.toggle('open');
        }

        function toggleAllFaq() {
            const items = document.querySelectorAll('.faq-item');
            const anyClosed = Array.from(items).some(i => !i.classList.contains('open'));
            items.forEach(i => i.classList.toggle('open', anyClosed));
        }

        // 2. Filtros por pestaña y búsqueda en tiempo real
        function applyManualFilters() {
            const term = document.getElementById('manualSearchInput').value.trim().toLowerCase();
            const clearBtn = document.getElementById('clearSearchBtn');
            clearBtn.classList.toggle('d-none', term.length === 0);

            const sections = document.querySelectorAll('.manual-section');
            let visibleCount = 0;

            sections.forEach(sec => {
                const cat = sec.getAttribute('data-category');
                const keywords = (sec.getAttribute('data-keywords') || '').toLowerCase();
                const textContent = sec.innerText.toLowerCase();

                const matchesCat = (activeCategory === 'all') || (cat === activeCategory);
                const matchesSearch = !term || keywords.includes(term) || textContent.includes(term);

                const show = matchesCat && matchesSearch;
                sec.classList.toggle('d-none', !show);
                if (show) {
                    visibleCount++;
                    // Si hay término de búsqueda, expandir automáticamente FAQs coincidentes
                    if (term && cat === 'faq') {
                        sec.querySelectorAll('.faq-item').forEach(faq => {
                            const fText = faq.innerText.toLowerCase() + ' ' + (faq.getAttribute('data-faq-keywords') || '');
                            faq.classList.toggle('open', fText.includes(term));
                        });
                    }
                }
            });

            document.getElementById('manualNoResults').classList.toggle('d-none', visibleCount > 0);
        }

        function resetManualFilters() {
            document.getElementById('manualSearchInput').value = '';
            activeCategory = 'all';
            document.querySelectorAll('.manual-tab-btn').forEach(b => {
                b.classList.toggle('active', b.getAttribute('data-filter') === 'all');
            });
            applyManualFilters();
        }

        document.querySelectorAll('.manual-tab-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.manual-tab-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                activeCategory = this.getAttribute('data-filter');
                applyManualFilters();
            });
        });

        document.getElementById('manualSearchInput').addEventListener('input', applyManualFilters);
        document.getElementById('clearSearchBtn').addEventListener('click', function () {
            document.getElementById('manualSearchInput').value = '';
            applyManualFilters();
            document.getElementById('manualSearchInput').focus();
        });

        // 3. Checklist interactivo persistente en localStorage
        function loadChecklist() {
            let saved = {};
            try { saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); } catch { saved = {}; }

            document.querySelectorAll('#dailyChecklist .checklist-item').forEach(item => {
                const key = item.getAttribute('data-step');
                const cb = item.querySelector('input[type="checkbox"]');
                const checked = !!saved[key];
                cb.checked = checked;
                item.classList.toggle('completed', checked);
            });
            updateChecklistProgress();
        }

        function updateChecklistProgress() {
            const items = document.querySelectorAll('#dailyChecklist .checklist-item');
            const total = items.length;
            let done = 0;
            const state = {};

            items.forEach(item => {
                const key = item.getAttribute('data-step');
                const cb = item.querySelector('input[type="checkbox"]');
                item.classList.toggle('completed', cb.checked);
                state[key] = cb.checked;
                if (cb.checked) done++;
            });

            localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
            const pct = total > 0 ? Math.round((done / total) * 100) : 0;
            document.getElementById('checklistProgressBar').style.width = pct + '%';
            document.getElementById('checklistProgressLabel').textContent = `${done} / ${total} completados`;
        }

        function resetChecklist() {
            localStorage.removeItem(STORAGE_KEY);
            loadChecklist();
        }

        document.querySelectorAll('#dailyChecklist input[type="checkbox"]').forEach(cb => {
            cb.addEventListener('change', updateChecklistProgress);
        });

        loadChecklist();
    </script>
}
